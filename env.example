# Copy to `env` (git-ignored) and fill in. None of these values are secret,
# but they identify your Okta org, so keep `env` out of version control.
OKTA_ORG_URL="https://your-org.okta.com"   # no "-admin" in the hostname
OKTA_CLIENT_ID="your-client-id"
OKTA_KEY_ID="your-key-id"

# 1Password secret reference to the PEM private key (e.g. a Secure Note's body).
OKTA_PRIVATE_KEY_REF="op://dev/Okta access review key/notesPlain"

# Space-separated. Read scopes only: the tool refuses to start with anything else.
OKTA_SCOPES="okta.users.read okta.groups.read okta.apps.read okta.appGrants.read okta.roles.read okta.logs.read okta.apiTokens.read"

# Bind access tokens to a per-run key (DPoP). Must match "Require DPoP" on the app.
OKTA_DPOP="true"

# --- Emailing the PDF report (optional) ---
# Leave REPORT_EMAIL_TO empty to turn email off. Comma-separate multiple recipients.
REPORT_EMAIL_TO=""
REPORT_EMAIL_FROM="Access Review <access-review@your-verified-domain.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"          # 587 = STARTTLS, 465 = TLS. Plain-text SMTP is refused.
SMTP_USERNAME="your-smtp-username"
# 1Password secret reference to the SMTP password or API key.
SMTP_PASSWORD_REF="op://dev/Access review SMTP/credential"

# --- Posting a summary to Slack (optional) ---
# Use ONE of these, as a 1Password secret reference. Leave both empty to turn Slack off.
#
# a) Incoming webhook (https://hooks.slack.com/services/...): summary only.
#    The URL is a secret: anyone who has it can post to the channel.
SLACK_WEBHOOK_URL_REF=""
#
# b) Bot token (xoxb-..., scopes chat:write and files:write): summary, plus the PDF
#    in the message thread if SLACK_ATTACH_PDF is true. Invite the app to the channel.
SLACK_BOT_TOKEN_REF=""
SLACK_CHANNEL_ID=""        # e.g. C0123456789 (channel details, About tab); not secret
# The PDF contains personal data. Only turn this on for a private, need-to-know channel.
SLACK_ATTACH_PDF="false"
